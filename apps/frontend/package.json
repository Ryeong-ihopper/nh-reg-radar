{
  "name": "nh-ad-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "openapi:generate": "openapi-typescript ../../openapi/openapi.yaml -o src/api/generated/openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- src/api/generated/openapi.ts",
    "visual:local": "node scripts/capture-local-visual.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@fontsource/noto-sans-kr": "^5.2.9",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "7.9.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
