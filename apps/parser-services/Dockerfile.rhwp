FROM rust:1.93.1-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends git pkg-config libfontconfig1-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/edwardkim/rhwp.git /src/rhwp \
    && cd /src/rhwp \
    && git checkout 93862a4e16df59834ebce46d91e948cd739208e9 \
    && cargo build --release

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends fontconfig libfontconfig1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/rhwp/target/release/rhwp /usr/local/bin/rhwp
COPY apps/parser-services/requirements-common.txt ./
RUN pip install --no-cache-dir -r requirements-common.txt
COPY apps/parser-services/service.py apps/parser-services/rhwp_app.py ./
EXPOSE 8093
CMD ["uvicorn", "rhwp_app:app", "--host", "0.0.0.0", "--port", "8093"]
