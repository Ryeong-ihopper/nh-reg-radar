FROM paddlepaddle/paddle:2.6.2

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY apps/parser-services/requirements-common.txt ./
RUN pip install --no-cache-dir -r requirements-common.txt paddleocr==2.9.1
COPY apps/parser-services/service.py apps/parser-services/paddleocr_app.py ./
EXPOSE 8092
CMD ["python", "-m", "uvicorn", "paddleocr_app:app", "--host", "0.0.0.0", "--port", "8092"]
