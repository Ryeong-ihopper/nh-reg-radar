+"""User intake, label spans and parser stage boundaries (no providers)."""
+import copy
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+
+from nh_parser.review import labeling, resolution
+from nh_parser.review.export import build_evidence, build_review_input
+
+
+def document():
+    return {"doc_id": "fixture", "source_file": "fixture.png", "pages": [{
+        "page_no": 1, "regions": [{"region_id": "r", "lines": [
+            {"text": "한빛은행"}, {"text": "연 4.2%"},
+        ]}],
+    }]}
+
+
+@pytest.mark.parametrize("classify_document", [False, True])
+def test_image_pipeline_respects_classification_switch(monkeypatch, classify_document):
+    from nh_parser import pipeline
+    from nh_parser.ir import AdPage
+
+    page = AdPage(page_no=1, parse_route="ocr", parse_status="ok")
+    monkeypatch.setattr(pipeline, "load_image_canvas", lambda path: SimpleNamespace(image=object()))
+    monkeypatch.setattr(pipeline, "_ocr_canvas_to_page", lambda *a, **k: page)
+    reader = Mock()
+    classifier = Mock()
+    monkeypatch.setattr(pipeline, "_apply_vlm_judgments", reader)
+    monkeypatch.setattr(pipeline, "_classify_into", classifier)
+    doc = pipeline.process_file(Path("fixture.png"), classify_document=classify_document)
+    assert len(doc.pages) == 1
+    reader.assert_called_once()
+    assert classifier.call_count == int(classify_document)
+
+
+def test_provided_template_never_resolves_from_file_or_model(monkeypatch):
+    model = Mock(side_effect=AssertionError("classification must not run"))
+    monkeypatch.setattr(resolution.vlm_client, "chat_json", model)
+    selected = resolution.provided_template("대출성상품-상품명 노출")
+    assert selected["template_id"] == "대출성상품-상품명 노출"
+    assert selected["source"] == "user_provided"
+    assert selected["confidence"] is None
+    for invalid in (None, "", "unknown"):
+        with pytest.raises(ValueError):
+            resolution.provided_template(invalid)
+    model.assert_not_called()
+
+
+@pytest.mark.parametrize("line_ids,confidence", [([-1, 1], .9), ([1, 0], .9), ([0, 5], .9),
+    ([True, 1], .9), ([0, 1], .4), ([0, 1], float('nan')), ([0, 0], .9), ([], .9),
+    ([0.0], .9), (["0"], .9), (None, .9), ([0], True)])
+def test_invalid_label_range_or_confidence_never_clamps_to_source(monkeypatch, line_ids, confidence):
+    raw = document()
+    original = copy.deepcopy(raw)
+    monkeypatch.setattr(labeling.vlm_client, "chat_json", lambda *a, **k: {"verdicts": [{
+        "region_id": "r", "gubun": "대출금리", "line_ids": line_ids,
+        "confidence": confidence, "reason": "test",
+    }]})
+    selected = resolution.provided_template("대출성상품-상품명 노출")
+    result = labeling.label_regions(raw, selected)
+    assert result["by_region"]["r"] == []
+    assert result["needs_review_regions"] == ["r"]
+    p1 = build_evidence(raw, selected, result)
+    p3 = build_review_input(p1)
+    assert p3["pages"][0]["regions"][0]["needs_review"] is True
+    assert raw == original
+
+
+def test_lower_labels_keep_separate_canonical_line_spans(monkeypatch):
+    def response(parts, **kwargs):
+        assert "대출성상품-상품명 노출" in parts[0]["text"]
+        return {"verdicts": [{"region_id": "r", "gubun": label, "line_ids": [i],
+                              "confidence": .9, "reason": "본문 근거"}
+                             for i, label in enumerate(("회사명", "대출금리"))]}
+    monkeypatch.setattr(labeling.vlm_client, "chat_json", response)
+    raw = document()
+    selected = resolution.provided_template("대출성상품-상품명 노출")
+    p1 = build_evidence(raw, selected, labeling.label_regions(raw, selected))
+    labels = {label["label"]: label for label in p1["pages"][0]["regions"][0]["template_labels"]}
+    assert labels["회사명"]["spans"][0]["line_refs"] == ["p1/r/L000"]
+    assert labels["대출금리"]["spans"][0]["line_refs"] == ["p1/r/L001"]
+
+
+def test_nonadjacent_label_lines_do_not_cover_intervening_field(monkeypatch):
+    raw = document()
+    raw["pages"][0]["regions"][0]["lines"] = [
+        {"text": "적용 이율"}, {"text": "고객 부담 비용 없음"}, {"text": "연 4.2%"},
+    ]
+
+    def response(parts, **kwargs):
+        properties = kwargs["schema"]["properties"]["verdicts"]["items"]["properties"]
+        assert "line_ids" in properties and "line_from" not in properties
+        return {"verdicts": [{"region_id": "r", "gubun": "대출금리", "line_ids": [0, 2],
+                              "confidence": .9, "reason": "같은 표 열의 표제와 값"}]}
+
+    monkeypatch.setattr(labeling.vlm_client, "chat_json", response)
+    selected = resolution.provided_template("대출성상품-상품명 노출")
+    p1 = build_evidence(raw, selected, labeling.label_regions(raw, selected))
+    p3 = build_review_input(p1)
+    spans = p3["pages"][0]["regions"][0]["labels"][0]["spans"]
+    assert [span["line_refs"] for span in spans] == [["p1/r/L000"], ["p1/r/L002"]]
+    assert len(p3["pages"][0]["regions"][0]["line_refs"]) == 3
+
+
+@pytest.mark.parametrize("bad_span", [
+    {"line_from": -1, "line_to": 1}, {"line_from": 0, "line_to": 2},
+    {"line_from": 1, "line_to": 0}, {"line_from": True, "line_to": 1},
+    {"line_from": "0", "line_to": 1}, {"line_from": 0}, {},
+    {"line_from": 0, "line_to": 0, "line_refs": ["p1/r/L001"]},
+])
+def test_export_rejects_invalid_spans_but_preserves_valid_evidence(bad_span):
+    raw = document()
+    original = copy.deepcopy(raw)
+    selected = resolution.provided_template("대출성상품-상품명 노출")
+    result = {"status": "complete", "template_id": selected["template_id"], "by_region": {"r": [{
+        "label_id": "rate", "label": "대출금리", "spans": [
+            bad_span, {"line_from": 1, "line_to": 1, "sources": ["semantic_vlm"]},
+        ],
+    }]}}
+    p1 = build_evidence(raw, selected, result)
+    p3 = build_review_input(p1)
+    region = p3["pages"][0]["regions"][0]
+    assert region["needs_review"] is True
+    assert p1["template"]["labeling_status"] == "partial"
+    assert [span["line_refs"] for span in region["labels"][0]["spans"]] == [["p1/r/L001"]]
+    assert raw == original
+
+
+def test_label_prompt_preserves_line_coordinates_without_font_inference():
+    raw = {"region_id": "r", "bbox": [0, 0, 500, 100], "lines": [
+        {"text": "회사명", "bbox": [0, 10, 100, 30]},
+        {"text": "한빛은행", "bbox": [200, 10, 400, 30]},
+    ]}
+    prompt = labeling._region_text(raw)
+    assert "[00] bbox=[0, 10, 100, 30] 회사명" in prompt
+    assert "[01] bbox=[200, 10, 400, 30] 한빛은행" in prompt
+    assert "font" not in prompt
+
+
+def test_label_prompt_keeps_all_template_instructions():
+    instructions = ["검사 조건 " + str(i) + " 가" * 150 for i in range(4)]
+    text = labeling._definitions({"items": [{"gubun": "항목", "entries": [
+        {"required": "O", "instructions": instruction} for instruction in instructions
+    ]}]})
+    assert all(instruction in text for instruction in instructions)
+
+
+def test_selected_reading_is_context_only_and_low_quality_lines_have_no_labels(monkeypatch):
+    raw = document()
+    region = raw["pages"][0]["regions"][0]
+    region["lines"] = [{"text": "금리", "source": "ocr", "confidence": .2},
+                       {"text": "연 4.2%", "source": "digital", "confidence": 1.0}]
+    region["reading_adjudication"] = {"proposed_source": "element_vlm",
+        "proposed_text": "금리 연 7.8%", "judge_decision": "candidate_b"}
+    before = copy.deepcopy(raw)
+
+    def response(parts, **kwargs):
+        assert "P3_CONTEXT_ONLY" in parts[0]["text"]
+        assert "confidence=0.2, needs_review=True" in parts[0]["text"]
+        return {"verdicts": [{"region_id": "r", "gubun": "금리", "line_ids": [0, 1],
+                              "confidence": 1.0, "reason": "model confidence is not OCR quality"}]}
+
+    monkeypatch.setattr(labeling.vlm_client, "chat_json", response)
+    selected = resolution.provided_template("예금성상품-적립식")
+    labels = labeling.label_regions(raw, selected)
+    p1 = build_evidence(raw, selected, labels)
+    p3 = build_review_input(p1)
+    assert raw == before
+    assert labels["needs_review_regions"] == ["r"]
+    assert labels["by_region"]["r"][0]["spans"][0]["line_from"] == 1
+    assert len(labels["by_region"]["r"][0]["spans"]) == 1
+    assert p3["pages"][0]["regions"][0]["selected_text"] == "금리 연 7.8%"
+    assert p3["pages"][0]["regions"][0]["needs_review"]
+
+
+@pytest.mark.parametrize("line,expected", [
+    ({"text": "정상", "source": "ocr", "confidence": .95}, False),
+    ({"text": "정상", "source": "digital", "confidence": .2}, False),
+    ({"text": "정상", "source": "ocr", "confidence": None}, False),
+    ({"text": "손상\ufffd", "source": "digital"}, True),
+    ({"text": "손상\x00", "source": "ocr", "confidence": .99}, True),
+    ({"text": "미확정", "source": "ocr", "confidence": float("nan")}, True),
+])
+def test_label_quality_gate_uses_observations_not_specific_ad_words(line, expected):
+    assert labeling._uncertain_line(line) is expected
+
+
+def test_cli_skips_document_and_template_classification(monkeypatch, tmp_path):
+    # Stub the expensive parser boundary, preserving the actual review exporter.
+    import json
