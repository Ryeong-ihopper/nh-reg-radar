# Elasticsearch is reached through a local tunnel in the current PoC.
NH_RAG_ES_URL=http://127.0.0.1:19201
NH_RAG_ES_INDEX=nh-rules-v2-operational-core
NH_REGULATION_V2_PATH=C:/data/NH_광고심의_에이전트_규제목록_v2.xlsx

# GPU services. Keep real internal hostnames and key paths in the local .env only.
DGX_HOST=user@gpu-host
DGX_SSH_KEY=C:/path/to/private/key
DGX_BGE_LOCAL_ENDPOINT=http://127.0.0.1:8103
DGX_BGE_ENDPOINT=http://127.0.0.1:8103
DGX_GEMMA_LOCAL_ENDPOINT=http://127.0.0.1:8102/v1/chat/completions
DGX_GEMMA_REMOTE_ENDPOINT=http://127.0.0.1:8102/v1/chat/completions
DGX_GEMMA_MODEL=gemma-4-26b-NVFP4-MTP

# Operational API. A token is required unless the local-only development flag
# --allow-unauthenticated is explicitly supplied.
NH_RAG_API_TOKEN=replace-with-a-secret
NH_RAG_JOBS_DIR=C:/data/nh-rag-jobs
NH_RAG_QUEUE_WORKERS=1
NH_RAG_MODEL_WORKERS=4
NH_RAG_JUDGMENT_BATCH_SIZE=8
NH_RAG_EVIDENCE_PER_RULE=3
NH_RAG_PROHIBITION_MAX_CANDIDATES=30
NH_RAG_JOB_TIMEOUT_SECONDS=1800
NH_RAG_MAX_ATTEMPTS=3
