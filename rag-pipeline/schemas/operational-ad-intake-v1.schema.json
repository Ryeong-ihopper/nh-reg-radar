{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational advertisement intake v1",
  "type": "object",
  "required": ["schema_version", "advertisement_name", "media_codes", "assets", "products", "shared_asset_scopes"],
  "properties": {
    "schema_version": {"const": "operational-ad-intake-v1"},
    "advertisement_name": {"type": "string", "minLength": 1},
    "media_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assets": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["asset_id", "file_name"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "file_name": {"type": "string", "minLength": 1}}, "additionalProperties": false}},
    "products": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["product_id", "product_group", "product_classification_code", "asset_scopes"], "properties": {"product_id": {"type": "string", "minLength": 1}, "product_name": {"type": ["string", "null"]}, "product_group": {"enum": ["예금성", "대출성"]}, "product_classification_code": {"type": "string", "minLength": 1}, "asset_scopes": {"type": "array", "items": {"$ref": "#/$defs/asset_scope"}}}, "additionalProperties": false}},
    "shared_asset_scopes": {"type": "array", "items": {"$ref": "#/$defs/asset_scope"}},
    "follow_up": {"type": ["object", "null"], "properties": {"is_follow_up": {"type": "boolean"}, "predecessor_ad_id": {"type": ["string", "null"]}}, "required": ["is_follow_up", "predecessor_ad_id"], "additionalProperties": false}
  },
  "additionalProperties": false,
  "$defs": {
    "page_range": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "asset_scope": {"type": "object", "required": ["asset_id", "page_ranges"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "page_ranges": {"type": ["array", "null"], "items": {"$ref": "#/$defs/page_range"}}}, "additionalProperties": false}
  }
}
