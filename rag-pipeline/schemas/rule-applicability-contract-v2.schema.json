{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound applicability and obligation checklist contract v2",
  "type": "object",
  "required": [
    "schema_version",
    "scope_ref",
    "scope_text",
    "scope_source_sha256",
    "scope_policy",
    "product_groups",
    "product_subtype",
    "applicability_mode",
    "applicability_conditions",
    "review_conditions",
    "rule_relations",
    "obligation",
    "unknown_policy",
    "source_note",
    "obligation_checks",
    "obligation_policy",
    "obligation_structure"
  ],
  "properties": {
    "schema_version": {
      "const": "rule-applicability-contract-v2"
    },
    "scope_ref": {
      "const": "SCOPE"
    },
    "scope_text": {
      "type": "string",
      "minLength": 1
    },
    "scope_source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_policy": {
      "type": "string",
      "minLength": 1
    },
    "product_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "product_subtype": {
      "type": [
        "string",
        "null"
      ]
    },
    "applicability_mode": {
      "enum": [
        "UNCONDITIONAL",
        "SOURCE_SCOPED",
        "CONDITIONAL"
      ]
    },
    "applicability_conditions": {
      "$ref": "#/$defs/conditions"
    },
    "review_conditions": {
      "$ref": "#/$defs/conditions"
    },
    "rule_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "relation_type",
          "target_item_ids",
          "join",
          "source"
        ],
        "properties": {
          "relation_type": {
            "const": "SATISFIED_IF"
          },
          "target_item_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z]+-[A-Za-z0-9]+$"
            }
          },
          "join": {
            "enum": [
              "ANY",
              "ALL"
            ]
          },
          "description": {
            "type": "string"
          },
          "source": {
            "const": "실행_점검항목"
          }
        },
        "additionalProperties": false
      }
    },
    "obligation": {
      "type": "object",
      "required": [
        "obligation_id",
        "text",
        "source"
      ],
      "properties": {
        "obligation_id": {
          "const": "O1"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "const": "criterion"
        }
      },
      "additionalProperties": false
    },
    "unknown_policy": {
      "const": "UNDETERMINED"
    },
    "source_note": {
      "type": "string"
    },
    "obligation_policy": {
      "type": "string",
      "minLength": 1
    },
    "obligation_structure": {
      "enum": [
        "SOURCE_TEXT_ONLY",
        "SOURCE_PLUS_EXPLICIT_REQUIREMENTS",
        "SOURCE_EXPLICIT_ALTERNATIVES"
      ]
    },
    "obligation_logic": {
      "$ref": "#/$defs/obligationLogic"
    },
    "obligation_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "obligation_id",
          "text",
          "source"
        ],
        "properties": {
          "obligation_id": {
            "type": "string",
            "pattern": "^O[1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "enum": [
              "criterion",
              "bound_guide.requirements",
              "template_alternative"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "guide_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "obligationLogic": {
      "oneOf": [
        {
          "type": "object", "required": ["ref"],
          "properties": {"ref": {"type": "string", "pattern": "^O[1-9][0-9]*$"}},
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["all"],
          "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligationLogic"}}},
          "additionalProperties": false
        },
        {
          "type": "object", "required": ["any"],
          "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/obligationLogic"}}},
          "additionalProperties": false
        }
      ]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "condition_id",
          "text",
          "source"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "pattern": "^[AU][1-9][0-9]*$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "const": "authoritative_rule_or_bound_guide"
          },
          "condition_role": {
            "enum": [
              "TRIGGER",
              "EXEMPTION",
              "REVIEW"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
