{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Template and case decision guidance bound to regulation v2",
  "type": "object",
  "required": ["schema_version", "regulation_v2_sha256", "guides"],
  "properties": {
    "schema_version": {"const": "review-decision-guide-v1"},
    "regulation_v2_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "guides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["guide_id", "item_id", "label", "requirements", "compliant_examples", "violation_conditions", "review_conditions"],
        "properties": {
          "guide_id": {"type": "string", "minLength": 1},
          "item_id": {"type": "string", "minLength": 1},
          "template_id": {"type": ["string", "null"]},
          "label": {"type": "string", "minLength": 1},
          "applicability_conditions": {"type": "array", "items": {"type": "string"}},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "compliant_examples": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "violation_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "violation_message": {"type": ["string", "null"]},
          "review_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "review_message": {"type": ["string", "null"]},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
