{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operational advertisement review request v1",
  "type": "object",
  "required": ["schema_version", "document", "routing_overrides"],
  "properties": {
    "schema_version": {"const": "operational-review-request-v1"},
    "client_request_id": {"type": ["string", "null"]},
    "review_date": {"type": ["string", "null"], "format": "date", "description": "Review day; service uses the original advertisement registration day in Korea time"},
    "review_date_basis": {"type": "string", "enum": ["explicit_review_date", "advertisement_registration_date"]},
    "document": {"$ref": "nh-ad-review-integrated-input-v1.schema.json"},
    "routing_overrides": {
      "type": "object",
      "required": ["product_group"],
      "properties": {
        "product_group": {"enum": ["예금성", "대출성", "투자성"]},
        "product_subtype": {"type": ["string", "null"]},
        "template_id": {"type": ["string", "null"]},
        "ad_type": {"type": ["string", "null"]},
        "product_name_shown": {"type": ["string", "null"]},
        "media_type": {"type": ["string", "null"]},
        "review_stage": {
          "type": ["string", "null"],
          "enum": ["사전심의", "사후보고", "게재전확인", null]
        },
        "association_pre_review": {
          "type": ["string", "null"],
          "enum": ["대상", "비대상", "미확정", null]
        },
        "external_evidence_available": {"type": ["boolean", "null"]}
      },
      "additionalProperties": false
    },
    "execute_model": {"type": "boolean", "default": true}
  },
  "additionalProperties": false
}
