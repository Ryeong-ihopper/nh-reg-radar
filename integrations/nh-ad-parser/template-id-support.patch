@@ -0,0 +1,85 @@
+import copy
+
+
+import importlib.util
+
+
+import sys
+
+
+from pathlib import Path
+
+
+from types import SimpleNamespace
+
+
+from unittest.mock import Mock
+
+
+import pytest
+
+
+from nh_parser.review import labeling, resolution
+
+
+from nh_parser.review.export import build_evidence, build_review_input
+
+
+def document():
+    return {"doc_id": "fixture", "source_file": "fixture.png", "pages": [{
+        "page_no": 1, "regions": [{"region_id": "r", "lines": [
+            {"text": "한빛은행"}, {"text": "연 4.2%"},
+        ]}],
+    }]}
+
+
+@pytest.mark.parametrize("classify_document", [False, True])
+def test_image_pipeline_respects_classification_switch(monkeypatch, classify_document):
+    from nh_parser import pipeline
+    from nh_parser.ir import AdPage
+
+    page = AdPage(page_no=1, parse_route="ocr", parse_status="ok")
+    monkeypatch.setattr(pipeline, "load_image_canvas", lambda path: SimpleNamespace(image=object()))
+    monkeypatch.setattr(pipeline, "_ocr_canvas_to_page", lambda *a, **k: page)
+    reader = Mock()
+    classifier = Mock()
+    monkeypatch.setattr(pipeline, "_apply_vlm_judgments", reader)
+    monkeypatch.setattr(pipeline, "_classify_into", classifier)
+    doc = pipeline.process_file(Path("fixture.png"), classify_document=classify_document)
+    assert len(doc.pages) == 1
+    reader.assert_called_once()
+    assert classifier.call_count == int(classify_document)
+
+
+def test_provided_template_never_resolves_from_file_or_model(monkeypatch):
+    model = Mock(side_effect=AssertionError("classification must not run"))
+    monkeypatch.setattr(resolution.vlm_client, "chat_json", model)
+    selected = resolution.provided_template("대출성상품-상품명 노출")
+    assert selected["template_id"] == "대출성상품-상품명 노출"
+    assert selected["source"] == "user_provided"
+    assert selected["confidence"] is None
+    for invalid in (None, "", "unknown"):
+        with pytest.raises(ValueError):
+            resolution.provided_template(invalid)
+    model.assert_not_called()
+
+
+def test_cli_skips_document_and_template_classification(monkeypatch, tmp_path):
+    # Stub the expensive parser boundary, preserving the actual review exporter.
+    import json
+    process = Mock(return_value=SimpleNamespace(model_dump_json=lambda: json.dumps(document())))
+    monkeypatch.setitem(sys.modules, "nh_parser.pipeline", SimpleNamespace(process_file=process))
+    monkeypatch.setattr(labeling.vlm_client, "chat_json", lambda *a, **k: {"verdicts": []})
+    spec = importlib.util.spec_from_file_location("parse_cli_test", Path(__file__).parents[1] / "tools/parse.py")
+    cli = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(cli)
+    with pytest.raises(ValueError):
+        cli.parse_one(Path("unrelated.png"), tmp_path, False)
+    process.assert_not_called()
+    cli.parse_one(Path("unrelated.png"), tmp_path, False, template_id="대출성상품-상품명 노출")
+    assert process.call_args.kwargs["classify_document"] is False
+    saved = json.loads((tmp_path / "evidence/unrelated.json").read_text(encoding="utf-8"))
+    assert saved["template"]["source"] == "user_provided"
+    assert saved["template"]["template_id"] == "대출성상품-상품명 노출"
+
+
