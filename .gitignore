# 수집 산출물 — 재실행하면 다시 만들어진다. 용량이 커서(원본 HWP/PDF 포함) 커밋하지 않는다.
# 필요하면 output/_reports/latest_report.md 정도만 예외로 올린다.
output/files/
output/_versions/
output/_review/
output/*.json
output/*.txt
output/regulations.db
output/regulations.db-wal
output/regulations.db-shm

# 실행 리포트 — 돌릴 때마다 쌓이는 산출물이라 커밋하지 않는다
output/_reports/

# 실행 상태 — 환경마다 다르다
state.json
state.json.bak

# ── 공개 레포에 올리지 않는 것 ─────────────────────────────────────────
