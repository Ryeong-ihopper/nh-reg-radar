# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 수집 산출물 — 재실행하면 다시 만들어진다. 용량이 커서(원본 HWP/PDF 포함) 커밋하지 않는다.
# **output/ 전체를 통째로 제외**한다. 하위 폴더를 하나씩 적으면 새 폴더가 생겼을 때
# 그대로 커밋된다(실제로 _reference/ 가 그렇게 딸려 들어간 적 있음).
output/

# 실행 상태 — 환경마다 다르다
state.json
state.json.bak

# ── 공개 저장소에 올리지 않는 것 ───────────────────────────────────────
# 업무 문서(수집 범위·데이터 현황·진행 기록·업무일지). 저장소에는 코드만 둔다.
docs/

# 버려도 되는 것 모아두는 곳 (확인 후 삭제)
_cleanup/

# 로컬 도구 설정 (API 계정이 URL 에 들어 있다)
.claude/

*.log
