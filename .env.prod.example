COMPOSE_PROJECT_NAME=nh-ad-prod
APP_ENV=prod
IMAGE_PREFIX=nh-ad-compliance
RELEASE_TAG=release-tag-required
POSTGRES_DB=nh_ad_prod
POSTGRES_BOOTSTRAP_USER=nh_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=inject-bootstrap-secret
NH_DB_APP_PASSWORD=inject-app-secret
NH_DB_MIGRATION_PASSWORD=inject-migration-secret
NH_DB_READONLY_PASSWORD=inject-readonly-secret
NH_DB_ADMIN_PASSWORD=inject-admin-secret
NH_DB_RUNTIME_URL=postgresql+psycopg://app:inject-app-secret@postgres:5432/nh_ad_prod
NH_DB_MIGRATION_URL=postgresql+psycopg://migration:inject-migration-secret@postgres:5432/nh_ad_prod
JWT_SECRET=inject-at-least-32-character-jwt-secret
CORS_ALLOWED_ORIGINS=https://inject-poc-origin.example
REFRESH_COOKIE_SECURE=true
# Inject OPENAI_API_KEY from the deployment secret store; never commit a real key.
NH_EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=inject-from-github-secret
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=inject-from-github-secret-or-use-openai-api-key
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_ALLOW_INSECURE_HTTP=false
MINIO_ROOT_USER=inject-minio-user
MINIO_ROOT_PASSWORD=inject-minio-secret
OBJECT_STORAGE_ACCESS_KEY=inject-ad-backend-user
OBJECT_STORAGE_SECRET_KEY=inject-object-storage-secret
OBJECT_STORAGE_BUCKET_PREFIX=prod-
AD_ORIGINALS_BUCKET=prod-ad-originals
PARSER_ARTIFACTS_BUCKET=prod-parser-artifacts
REFERENCE_DOCUMENTS_BUCKET=prod-reference-documents
REPORTS_BUCKET=prod-reports
QDRANT_COLLECTION=prod_reference_chunks_v2
OPENSEARCH_INDEX=prod_reference_docs
REDIS_QUEUE_PREFIX=prod:queue:
REDIS_CACHE_PREFIX=prod:cache:
FRONTEND_PORT=8080
BACKEND_PORT=8000
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
