COMPOSE_PROJECT_NAME=nh-ad-dev
APP_ENV=dev
IMAGE_PREFIX=nh-ad-compliance
RELEASE_TAG=dev
POSTGRES_DB=nh_ad_dev
POSTGRES_BOOTSTRAP_USER=nh_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=dev-only-bootstrap-password
NH_DB_APP_PASSWORD=dev-only-app-password
NH_DB_MIGRATION_PASSWORD=dev-only-migration-password
NH_DB_READONLY_PASSWORD=dev-only-readonly-password
NH_DB_ADMIN_PASSWORD=dev-only-admin-password
NH_DB_RUNTIME_URL=postgresql+psycopg://app:dev-only-app-password@postgres:5432/nh_ad_dev
NH_DB_MIGRATION_URL=postgresql+psycopg://migration:dev-only-migration-password@postgres:5432/nh_ad_dev
JWT_SECRET=dev-only-jwt-secret-at-least-32-characters-long
CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
REFRESH_COOKIE_SECURE=false
# External AI is opt-in. Leave disabled for deterministic/provider-free development.
NH_EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=120
# OpenAI-compatible embedding endpoint. Defaults reuse the OpenAI key/base URL.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_TIMEOUT_SECONDS=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_ALLOW_INSECURE_HTTP=false
MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=dev-only-minio-password
OBJECT_STORAGE_ACCESS_KEY=dev-ad-backend
OBJECT_STORAGE_SECRET_KEY=dev-only-object-storage-secret
OBJECT_STORAGE_BUCKET_PREFIX=dev-
AD_ORIGINALS_BUCKET=dev-ad-originals
PARSER_ARTIFACTS_BUCKET=dev-parser-artifacts
REFERENCE_DOCUMENTS_BUCKET=dev-reference-documents
REPORTS_BUCKET=dev-reports
QDRANT_COLLECTION=dev_reference_chunks_v2
OPENSEARCH_INDEX=dev_reference_docs
REDIS_QUEUE_PREFIX=dev:queue:
REDIS_CACHE_PREFIX=dev:cache:
FRONTEND_PORT=5173
BACKEND_PORT=8000
WORKER_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_PORT=6333
OPENSEARCH_PORT=9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
